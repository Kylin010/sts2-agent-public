+    // Finish the preceding choice, or expose its next genuine player prompt.
+    // Never return old event options while the callback is still modifying it.
+    private void WaitForEventTask(ref Task? pending, string label, bool pumpContext = true, int maxWaitMs = 25000, bool allowCrystalInput = true)
+    {
+        var task = pending;
+        if (task == null) return;
+        var deadline = Environment.TickCount64 + maxWaitMs;
+        while (!task.IsCompleted)
+        {
+            if (HasEventInput(allowCrystalInput) || CombatManager.Instance.IsInProgress) return;
+            if (pumpContext) _syncCtx.Pump();
+            if (HasEventInput(allowCrystalInput) || CombatManager.Instance.IsInProgress) return;
+            if (Environment.TickCount64 >= deadline)
+            {
+                _eventFailure = new TimeoutException(label + " did not complete or request input");
+                throw _eventFailure;
+            }
+            Thread.Sleep(5);
+        }
+        try { task.GetAwaiter().GetResult(); }
+        catch (Exception ex) { _eventFailure = ex; throw; }
+        pending = null;
+    }
