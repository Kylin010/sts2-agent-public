+    private Dictionary<string, object?> DoCrystalClick(Dictionary<string, object?>? args)
+    {
+        if (_crystalSphere == null || _crystalSphere.IsFinished)
+            return Error("No crystal sphere decision pending");
+        if (args == null || !args.ContainsKey("x") || !args.ContainsKey("y")
+            || !args.TryGetValue("tool", out var tool) || Convert.ToString(tool) is not ("Big" or "Small"))
+            return Error("crystal_click needs public x, y and Big/Small tool");
+        var game = _crystalSphere;
+        int x = Convert.ToInt32(args["x"]), y = Convert.ToInt32(args["y"]);
+        if (x < 0 || x >= game.GridSize.X || y < 0 || y >= game.GridSize.Y)
+            return Error("Crystal coordinate outside visible board");
+        game.SetTool(Convert.ToString(tool) == "Small"
+            ? CrystalSphereMinigame.CrystalSphereToolType.Small
+            : CrystalSphereMinigame.CrystalSphereToolType.Big);
+        // The last click may run the original reward continuation inline.
+        // Keep it off the request thread, preserving actual reward prompts.
+        _crystalClickTask = Task.Run(() => game.CellClicked(game.cells[x, y]));
