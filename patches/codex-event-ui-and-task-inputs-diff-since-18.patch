+using System.Reflection;
+using System.Reflection.Emit;
+using System.Runtime.CompilerServices;
+using HarmonyLib;
+using MegaCrit.Sts2.Core.Audio.Debug;
+using MegaCrit.Sts2.Core.Context;
+using MegaCrit.Sts2.Core.Entities.Players;
+using MegaCrit.Sts2.Core.Models.Events;
+using MegaCrit.Sts2.Core.Nodes;
+using MegaCrit.Sts2.Core.Nodes.Vfx.Utilities;
+
+namespace Sts2Headless;
+
+// Scoped replacements for absent audiovisual nodes. Original event methods,
+// RNG, costs, card operations, rewards and combat transitions keep running.
+internal static class EventUiCompatibility
+{
+    private static readonly Dictionary<MethodBase, int> ExpectedCalls = new();
+
+    public static void Install()
+    {
+        var harmony = new Harmony("sts2headless.event-ui-compatibility");
+        foreach (var spec in new[] {
+            (typeof(DenseVegetation), "Rest", 4),
+            (typeof(JungleMazeAdventure), "SafetyInNumbers", 1),
+            (typeof(Amalgamator), "CombineStrikes", 2),
+            (typeof(Amalgamator), "CombineDefends", 2),
+            (typeof(PunchOff), "Nab", 1) })
+        {
+            var callback = spec.Item1.GetMethod(spec.Item2, BindingFlags.NonPublic | BindingFlags.Instance)
+                ?? throw new MissingMethodException(spec.Item1.Name, spec.Item2);
+            var body = callback.GetCustomAttribute<AsyncStateMachineAttribute>()?.StateMachineType
+                .GetMethod("MoveNext", BindingFlags.NonPublic | BindingFlags.Public | BindingFlags.Instance)
+                ?? throw new MissingMethodException("Missing event state machine: " + spec.Item2);
+            ExpectedCalls[body] = spec.Item3;
+            harmony.Patch(body, transpiler: new HarmonyMethod(typeof(EventUiCompatibility)
+                .GetMethod(nameof(CosmeticCallsTranspiler))));
+        }
+        var trial = typeof(Trial).GetMethod("Accept", BindingFlags.NonPublic | BindingFlags.Instance)
+            ?? throw new MissingMethodException("Trial.Accept");
+        harmony.Patch(trial, transpiler: new HarmonyMethod(typeof(EventUiCompatibility)
+            .GetMethod(nameof(TrialPortraitTranspiler))));
+    }
+
+    public static int SkipAudioPlay(NDebugAudioManager? audio, string stream, float volume, PitchVariance variance) => 0;
+    public static void SkipAudioStop(NDebugAudioManager? audio, int handle, float fadeTime) { }
+    public static void SkipRumble(NGame? game, ShakeStrength strength, ShakeDuration duration, RumbleStyle style) { }
+    public static void SkipShake(NGame? game, ShakeStrength strength) { }
+
+    public static IEnumerable<CodeInstruction> CosmeticCallsTranspiler(
+        IEnumerable<CodeInstruction> instructions, MethodBase __originalMethod)
+    {
+        var methods = new Dictionary<MethodInfo, MethodInfo> {
+            [typeof(NDebugAudioManager).GetMethod("Play")!] = typeof(EventUiCompatibility).GetMethod(nameof(SkipAudioPlay))!,
+            [typeof(NDebugAudioManager).GetMethod("Stop")!] = typeof(EventUiCompatibility).GetMethod(nameof(SkipAudioStop))!,
+            [typeof(NGame).GetMethod(nameof(NGame.ScreenRumble))!] = typeof(EventUiCompatibility).GetMethod(nameof(SkipRumble))!,
+            [typeof(NGame).GetMethod(nameof(NGame.ScreenShakeTrauma))!] = typeof(EventUiCompatibility).GetMethod(nameof(SkipShake))!
+        };
+        // Amalgamator and PunchOff already use ?. for audio. Replace only their
+        // unsafe shake call. DenseVegetation and JungleMaze use direct audio.
+        bool audio = __originalMethod.DeclaringType?.DeclaringType == typeof(DenseVegetation)
+            || __originalMethod.DeclaringType?.DeclaringType == typeof(JungleMazeAdventure);
+        int changed = 0;
+        foreach (var instruction in instructions)
+        {
+            if (instruction.operand is MethodInfo original && methods.TryGetValue(original, out var replacement)
+                && (audio || original.DeclaringType == typeof(NGame)))
+            {
+                ValidateSignature(original, replacement);
+                instruction.opcode = OpCodes.Call;
+                instruction.operand = replacement;
+                changed++;
+            }
+            yield return instruction; // Preserve labels, branches and exception blocks.
+        }
+        if (!ExpectedCalls.TryGetValue(__originalMethod, out var expected) || changed != expected)
+            throw new InvalidOperationException("Unexpected event cosmetic IL contract: "
+                + __originalMethod.DeclaringType?.Name + " calls=" + changed);
+        Console.Error.WriteLine("[INFO] Event cosmetic calls patched: "
+            + __originalMethod.DeclaringType?.Name + " count=" + changed);
+    }
+
+    public static bool SkipTrialLocalPortrait(Player? player) => false;
+    public static void SkipTrialPortrait(Trial trial, string path) { }
+
+    public static IEnumerable<CodeInstruction> TrialPortraitTranspiler(IEnumerable<CodeInstruction> instructions)
+    {
+        // In Trial.Accept these two IsMe branches exclusively manipulate the
+        // portrait. AddVfxAnchoredToPortrait is also exclusively audiovisual.
+        // The original event RNG draw and case-dependent choices are untouched.
+        var local = typeof(LocalContext).GetMethod(nameof(LocalContext.IsMe), new[] { typeof(Player) })!;
+        var portrait = typeof(Trial).GetMethod("AddVfxAnchoredToPortrait", BindingFlags.NonPublic | BindingFlags.Instance)!;
+        var noLocal = typeof(EventUiCompatibility).GetMethod(nameof(SkipTrialLocalPortrait))!;
+        var noPortrait = typeof(EventUiCompatibility).GetMethod(nameof(SkipTrialPortrait))!;
+        int locals = 0, portraits = 0;
+        foreach (var instruction in instructions)
+        {
+            if (Equals(instruction.operand, local))
+            {
+                ValidateSignature(local, noLocal);
+                instruction.opcode = OpCodes.Call; instruction.operand = noLocal; locals++;
+            }
+            else if (Equals(instruction.operand, portrait))
+            {
+                ValidateSignature(portrait, noPortrait);
+                instruction.opcode = OpCodes.Call; instruction.operand = noPortrait; portraits++;
+            }
+            yield return instruction;
+        }
+        if (locals != 2 || portraits != 1)
+            throw new InvalidOperationException($"Unexpected Trial portrait IL: local={locals}, portrait={portraits}");
+        Console.Error.WriteLine("[INFO] Trial portrait calls patched: 3; RNG and choices preserved");
+    }
+
+    private static void ValidateSignature(MethodInfo original, MethodInfo replacement)
+    {
+        var source = original.GetParameters().Select(p => p.ParameterType).ToList();
+        if (!original.IsStatic) source.Insert(0, original.DeclaringType!);
+        if (original.ReturnType != replacement.ReturnType || !replacement.IsStatic
+            || !source.SequenceEqual(replacement.GetParameters().Select(p => p.ParameterType)))
+            throw new InvalidOperationException("Cosmetic replacement changes the evaluation stack: " + original.Name);
+    }
+}
