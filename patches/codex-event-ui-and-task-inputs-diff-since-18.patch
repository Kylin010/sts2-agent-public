+        {
+            var cell = game.cells[x, y];
+            var info = new Dictionary<string, object?> {
+                ["x"] = x, ["y"] = y, ["hidden"] = cell.IsHidden };
+            // Visible item textures lie under the cell's fog in the real UI.
+            // Never inspect or emit the item of an obscured cell.
+            if (!cell.IsHidden && cell.Item != null)
+                info["visible_item"] = cell.Item.GetType().Name;
+            cells.Add(info);
+        }
+        return new Dictionary<string, object?> {
+            ["type"] = "decision", ["decision"] = "crystal_sphere",
+            ["context"] = RunContext(), ["player"] = PlayerSummary(_runState!.Players[0]),
+            ["width"] = game.GridSize.X, ["height"] = game.GridSize.Y,
+            ["divinations_left"] = game.DivinationCount, ["cells"] = cells };
