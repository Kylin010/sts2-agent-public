+
+    private void SettleMerchantPurchase(int maxMs = 25000)
+    {
+        var task = _merchantPurchaseTask;
+        if (task == null) return;
+        try
+        {
+            var deadline = Environment.TickCount64 + maxMs;
+            while (!task.IsCompleted)
+            {
+                _syncCtx.Pump();
+                if (_cardSelector.HasPending || _cardSelector.HasPendingReward
+                    || (_pendingBundles != null && _pendingBundleTcs?.Task.IsCompleted == false)) return;
+                if (Environment.TickCount64 >= deadline)
+                    throw new TimeoutException("Relic purchase did not finish or request player input");
+                Thread.Sleep(5);
+            }
+            if (!task.GetAwaiter().GetResult())
+                throw new InvalidOperationException("Native relic purchase declined");
+        }
+        catch (Exception ex) { _merchantPurchaseFailure = ex; throw; }
+        _merchantPurchaseTask = null;
+        Log($"Bought relic: {_merchantReceiptName} for {_merchantReceiptPrice}g");
+    }
+
