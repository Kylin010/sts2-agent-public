+    private bool PumpUntilDone(Task? t, int maxMs = 30000)
+    {
+        if (t == null) return true;
+        var sw = System.Diagnostics.Stopwatch.StartNew();
+        while (!t.IsCompleted && sw.ElapsedMilliseconds < maxMs)
+        {
+            _syncCtx.Pump();
+            if (_cardSelector.HasPending || _cardSelector.HasPendingReward) return false;
+            Thread.Sleep(5);
+        }
+        _syncCtx.Pump();
+        return t.IsCompleted;
+    }
+
+    private Dictionary<string, object?> AfterRestOption()
+    {
+        WaitForActionExecutor();
+        var left = RunManager.Instance.RestSiteSynchronizer?.GetLocalOptions();
+        if (left != null && left.Count > 0)
+        {
+            Log($"Rest site: {left.Count} option(s) still available (e.g. Miniature Tent), staying");
+            return DetectDecisionPoint();
+        }
+        ForceToMap();
+        return MapSelectState();
+    }
