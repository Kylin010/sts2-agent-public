+    // 10/3（B-010）：事件选项在后台线程跑，await 之后的步骤（回血、换页、进战斗）排在同步队列里，要边推进队列边等它走完。
+    // 原来只推约 1 秒、再 task.Wait(2000) 干等（不推队列，任务走不动），负载高时返回旧选项；再选一次会在旧选项没走完时
+    // 又执行一个选项（实测：茂密植被先休息回血、又执行继续前进拿金币，强制战斗被跳过）。
+    private Task? _eventTask;
+    // 事件选项任务崩了（后台没有界面单例：音效 / 震屏 / 肖像）或超时：这一局按技术故障停下（Codex 审查：结束事件会保留一半效果，
+    // 例如茂密植被回了血却跳过强制战斗；回传旧页又能再选一次）。之后每个命令都回 EVENT_FAULT 错误，开新局 / 读档才清掉。
+    private string? _eventFault;
+
+    private void SettleEventTask(int maxMs = 30000)
+    {
+        var t = _eventTask;
+        if (t == null) return;
+        var sw = System.Diagnostics.Stopwatch.StartNew();
+        while (!t.IsCompleted && sw.ElapsedMilliseconds < maxMs)
+        {
+            _syncCtx.Pump();
+            if (_cardSelector.HasPending || _cardSelector.HasPendingReward || _pendingBundles != null) return;   // 事件在等玩家选牌 / 选包
+            Thread.Sleep(5);
+        }
+        if (t.IsFaulted) { Log($"Event option task faulted: {t.Exception?.GetBaseException()}"); _eventFault = $"faulted: {t.Exception?.GetBaseException().Message}"; }
+        if (t.IsCompleted) { _eventTask = null; _syncCtx.Pump(); }
+        else { Log($"Event option task still running after {maxMs} ms"); _eventFault = $"timeout {maxMs} ms"; }
+    }
 
