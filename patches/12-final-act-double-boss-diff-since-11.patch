+    // The native A10 map connects its first boss to SecondBossMapPoint.
+    // Keep ordinary map travel/rewards; no extra healing or new RNG draws.
+    private Dictionary<string, object?> FinishFinalActBoss()
+    {
+        var map = _runState?.Map;
+        var current = _runState?.CurrentMapCoord;
+        if (map == null || !current.HasValue)
+            return Error("Cannot verify final boss completion without a map position");
+        var first = map.BossMapPoint;
+        var second = map.SecondBossMapPoint;
+        if (RunManager.Instance.HasAscension(AscensionLevel.DoubleBoss) && second == null)
+            return Error("DoubleBoss ascension has no second boss map point");
+
+        bool At(MapPoint point) => current.Value.col == point.coord.col && current.Value.row == point.coord.row;
+        if (second != null && At(first))
+        {
+            Log("First final-act boss defeated; returning to map for second boss");
+            ForceToMap();
+            if (_runState!.CurrentRoom is not MapRoom)
+                return Error("Could not return to map after first final-act boss");
+            return MapSelectState();
+        }
+        if (!At(second ?? first))
+            return Error("Final boss completion is outside the final boss map point");
+
+        Log("All final-act bosses defeated; reporting victory");
+        return GameOverState(true);
     }
 
