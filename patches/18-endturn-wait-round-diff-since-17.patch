         // Ensure no actions are still running before ending turn
         WaitForActionExecutor();
+        var roundBefore = CombatManager.Instance.DebugOnlyGetState()?.RoundNumber ?? 0;   // 10/3（B-020）：结束回合后等回合真的推进
 
         Log($"Ending turn (round={CombatManager.Instance.DebugOnlyGetState()?.RoundNumber ?? 0})");
         _turnStarted.Reset();
@@ -1410,6 +1411,23 @@ public class RunSimulator
             }
         }
 
+        // 10/3（B-020）：事件里开打的战斗（拳击事件的两只打孔构装体等），结束回合的动作排在还没走完的事件任务后面，
+        // 上面的等待一看「还是出牌阶段」就返回了——回传的局面落后一步，程序按旧手牌 / 旧意图决定，接连结束回合等于跳过自己的回合
+        // （实测 100 局里 5 局因此死在普通战）。这里等回合数真的变了（或战斗结束 / 死了 / 弹出选牌），最多 10 秒；还不变就报技术故障，不回传旧局面。
+        var swEnd = System.Diagnostics.Stopwatch.StartNew();
