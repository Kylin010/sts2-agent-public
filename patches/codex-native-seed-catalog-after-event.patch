+    public Dictionary<string, object?> GenerateSeeds(int count)
+    {
+        if (_runState != null)
+            return Error("Seed generation is only allowed before starting a run");
+        if (count < 1 || count > 10000)
+            return Error("Seed count must be between 1 and 10000");
+        // One ordinary pre-run Chaotic stream, before worker processes start.
+        // Keep the entire returned list; the coordinator rejects duplicate pools.
+        var seeds = Enumerable.Range(0, count)
+            .Select(_ => SeedHelper.GetRandomSeed()).ToArray();
+        return new Dictionary<string, object?>
+        {
+            ["type"] = "seed_catalog",
+            ["source"] = "SeedHelper.GetRandomSeed; one normal Rng.Chaotic stream",
+            ["count"] = count,
+            ["seeds"] = seeds,
+        };
+    }
+
